{
  "name": "@krishnavmalak/react-native-dynamic-app-icon",
  "version": "1.0.0",
  "publishConfig": {
    "access": "public"
  },
  "description": "Complete runtime branding library for React Native New Architecture",
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "types": "lib/typescript/index.d.ts",
  "react-native": "src/index.ts",
  "source": "src/index.ts",
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "cpp",
    "*.podspec",
    "!lib/typescript/example",
    "!ios/build",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "build": "bob build",
    "release": "release-it"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "branding",
    "splash-screen",
    "dynamic-icon",
    "white-label"
  ],
  "author": "Senior Architect",
  "license": "MIT",
  "peerDependencies": {
    "@react-native-async-storage/async-storage": ">=1.17.0",
    "expo-file-system": ">=18.0.0",
    "react": "*",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "expo-file-system": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-native/babel-preset": "^0.86.0",
    "@react-native/eslint-config": "^0.73.0",
    "@react-native/jest-preset": "^0.86.0",
    "@types/jest": "^29.5.5",
    "@types/react": "^19.0.0",
    "eslint": "^8.51.0",
    "jest": "^29.7.0",
    "react-native-builder-bob": "^0.23.1",
    "release-it": "^20.2.1",
    "typescript": "^5.2.2"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  }
}
